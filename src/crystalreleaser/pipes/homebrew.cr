require "../artifact"
require "../context"
require "../pipe"
require "./checksum"
require "./release"

module Crystalreleaser
  module Pipes
    # A Homebrew formula per `brews:` entry, pointing at the tar.gz archives
    # of the release: written to dist/homebrew/ on every run (so a snapshot
    # can be inspected). It runs before the release is published and does no
    # request: HomebrewPush pushes the formula to the tap afterwards.
    class Homebrew < Pipe
      # Homebrew's block names per os and arch.
      OS_BLOCKS   = {"darwin" => "on_macos", "linux" => "on_linux"}
      ARCH_BLOCKS = {"amd64" => "on_intel", "arm64" => "on_arm"}

      def name : String
        "homebrew"
      end

      def description : String
        "generating the Homebrew formula"
      end

      def skip?(ctx : Context) : String?
        "no brews configured" if ctx.config.brews.empty?
      end

      def run(ctx : Context) : Nil
        ctx.config.brews.each do |brew|
          formula = formula(ctx, brew)
          path = ctx.dist_path("homebrew", "#{brew.name}.rb")
          Dir.mkdir_p(File.dirname(path))
          File.write(path, formula)
          ctx.artifacts.add(Artifact.new(Artifact::Type::Formula, "#{brew.name}.rb", ctx.relative(path)))
          ctx.logger.info("#{ctx.config.dist}/homebrew/#{brew.name}.rb")
        end
      end

      # Pushing happens on a real release only, and never without the release
      # itself: the pushed file would point at files that are not there.
      def self.publishing?(ctx : Context) : Bool
        options = ctx.options
        options.publish? && !ctx.snapshot? && !options.skip.includes?("publish") && !options.skip.includes?("release")
      end

      # Why a pipe that pushes a generated file does not run at all.
      def self.push_skipped?(ctx : Context, what : String) : String?
        return "snapshot" if ctx.snapshot?
        "the release is skipped: #{what} would point at files that are not there" if ctx.options.skip.includes?("release")
      end

      # Whether `path` is pushed to its repository in this run. Not while the
      # release is a draft: the URLs the file points at only answer once the
      # release is published, and everyone using the tap or the registry
      # would get a broken entry in the meantime. Nor when its `skip_upload`
      # says so: `true`, or `auto` for a pre-release, which the users of a tap
      # should not get from a plain upgrade.
      def self.pushing?(ctx : Context, path : String, skip_upload : String) : Bool
        return false unless publishing?(ctx)
        tag = ctx.version_info.tag
        if ctx.config.release.draft?
          ctx.logger.warn("release.draft is set: #{path} is not pushed, its URLs only work once the release is published")
        elsif skip_upload == "true"
          ctx.logger.info("skip_upload is set: #{path} is not pushed")
        elsif skip_upload == "auto" && !ctx.version_info.prerelease.empty?
          ctx.logger.info("skip_upload is auto and #{tag} is a pre-release: #{path} is not pushed")
        else
          return true
        end
        false
      end

      # "foo-bar" => FooBar, "node@20" => NodeAT20, like Homebrew's own
      # Formulary.class_s.
      def self.class_name(name : String) : String
        name.capitalize
          .gsub(/[-_.\s]([a-zA-Z0-9])/) { $1.upcase }
          .tr("+", "x")
          .sub(/(.)@(\d)/, "\\1AT\\2")
      end

      # Whether the formula must say its version. Homebrew reads it from the
      # download URL, and `brew audit --strict` refuses a `version` that says
      # the same thing. It reads it right when every archive name holds the
      # version, or when the version is plain numbers and the tag is that
      # version (`v1.2.3`); otherwise, a pre-release whose archive names do
      # not hold it, it reads something else (`64` from `amd64`, observed
      # with Homebrew 7.0.14), and the line is needed.
      def self.version_line?(ctx : Context, archives : Array(Artifact)) : Bool
        version = ctx.version_info.version
        return false if archives.all?(&.name.includes?(version))
        tag = ctx.version_info.tag
        !(version.matches?(/\A\d+(\.\d+)*\z/) && tag.in?(version, "v#{version}"))
      end

      # A Ruby double-quoted string literal. Ruby interpolates `#{...}`, but
      # also `#$global` and `#@ivar` without braces.
      def self.ruby_string(text : String) : String
        escaped = text.gsub('\\', "\\\\").gsub('"', "\\\"").gsub(/#(?=[{$@])/, "\\#")
        %("#{escaped}")
      end

      def formula(ctx : Context, brew : Config::Brew) : String
        archives = archives(ctx, brew)
        if archives.empty?
          raise PackageError.new("brews: no tar.gz archive for darwin or linux to point the #{brew.name} formula at")
        end
        String.build do |io|
          io << "# typed: false\n# frozen_string_literal: true\n\n"
          io << "# This file was generated by crystalreleaser. DO NOT EDIT.\n"
          io << "class " << Homebrew.class_name(brew.name) << " < Formula\n"
          io << "  desc " << Homebrew.ruby_string(brew.description) << '\n' unless brew.description.empty?
          io << "  homepage " << Homebrew.ruby_string(brew.homepage) << '\n' unless brew.homepage.empty?
          if Homebrew.version_line?(ctx, archives.values)
            io << "  version " << Homebrew.ruby_string(ctx.version_info.version) << '\n'
          end
          io << "  license " << Homebrew.ruby_string(brew.license) << '\n' unless brew.license.empty?

          OS_BLOCKS.each do |system, os_block|
            platforms = ARCH_BLOCKS.compact_map { |arch, block| archives[{system, arch}]?.try { |archive| {block, archive} } }
            next if platforms.empty?
            io << "\n  " << os_block << " do\n"
            platforms.each do |(arch_block, archive)|
              io << "    " << arch_block << " do\n"
              io << "      url " << Homebrew.ruby_string(download_url(ctx, archive)) << '\n'
              io << "      sha256 " << Homebrew.ruby_string(sha256(ctx, archive)) << '\n'
              io << "    end\n"
            end
            io << "  end\n"
          end

          io << "\n  def install\n" << indent(brew.install.presence || %(bin.install "#{brew.name}")) << "  end\n"
          io << "\n  test do\n" << indent(brew.test.presence || %(system bin/"#{brew.name}", "--version")) << "  end\n"
          io << "end\n"
        end
      end

      # The tar.gz archive of each (os, arch), preferring the archives that
      # contain a binary named after the formula.
      private def archives(ctx : Context, brew : Config::Brew) : Hash({String, String}, Artifact)
        candidates = ctx.artifacts.filter(type: Artifact::Type::Archive).select do |artifact|
          artifact.extra["format"]? == "tar.gz" && OS_BLOCKS.has_key?(artifact.os) && ARCH_BLOCKS.has_key?(artifact.arch)
        end
        named = candidates.select { |artifact| (artifact.extra["binaries"]? || "").split(',').includes?(brew.name) }
        candidates = named unless named.empty?

        result = {} of {String, String} => Artifact
        candidates.each do |artifact|
          key = {artifact.os.to_s, artifact.arch.to_s}
          if result.has_key?(key)
            raise PackageError.new("brews: two tar.gz archives for #{key[0]}/#{key[1]} (#{result[key].name}, #{artifact.name})")
          end
          result[key] = artifact
        end
        result
      end

      private def download_url(ctx : Context, archive : Artifact) : String
        ctx.download_url(archive.name)
      rescue error : ConfigError
        raise error if Homebrew.publishing?(ctx)
        "https://github.com/OWNER/REPO/releases/download/#{ctx.version_info.tag}/#{archive.name}"
      end

      private def sha256(ctx : Context, archive : Artifact) : String
        archive.sha256 ||= Checksum.sha256(File.join(ctx.dir, archive.path))
      end

      private def indent(text : String) : String
        text.strip.lines.join { |line| line.strip.empty? ? "\n" : "    #{line.rstrip}\n" }
      end
    end

    # Pushes the formulas the homebrew pipe wrote to their tap, once the
    # release they point at is published. Same name as that pipe, so that
    # --skip=homebrew covers both.
    class HomebrewPush < PublishPipe
      def name : String
        "homebrew"
      end

      def description : String
        "pushing the Homebrew formula"
      end

      def skip?(ctx : Context) : String?
        return "no brews configured" if ctx.config.brews.empty?
        Homebrew.push_skipped?(ctx, "the formula")
      end

      def run(ctx : Context) : Nil
        ctx.config.brews.each_with_index do |brew, index|
          path = File.join(brew.directory, "#{brew.name}.rb")
          next unless Homebrew.pushing?(ctx, path, brew.skip_upload)
          push(ctx, brew, index, path, File.read(ctx.dist_path("homebrew", "#{brew.name}.rb")))
        end
      end

      private def push(ctx : Context, brew : Config::Brew, index : Int32, path : String, formula : String) : Nil
        repository = brew.repository || raise ConfigError.new("brews[#{index}].repository is required to publish the formula")
        client = ctx.repository_client(repository, "brews[#{index}].repository")
        sha = client.file_sha(repository.owner, repository.name, path, repository.branch)
        client.put_file(repository.owner, repository.name, path, repository.branch, formula,
          "Brew formula update for #{brew.name} version #{ctx.version_info.tag}", sha)
        ctx.logger.info("pushed #{path}", repo: "#{repository.owner}/#{repository.name}")
      end
    end
  end
end
